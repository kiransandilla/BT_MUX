# Server Network Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (MongoDB Motor Async)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=bt_mux

# Hardware Abstraction Layer (HAL) Transport Configuration
# Options: 'simulated' | 'winrt' | 'linux-bluez'
BLE_TRANSPORT=simulated

# Scheduler Defaults
DEFAULT_T_SLICE_MS=500
